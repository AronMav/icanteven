{
	log default {
		exclude http.log.access http.log.error
	}
	servers {
		timeouts {
			read_header 5s
			read_body 5s
			write 30s
			idle 2m
		}
	}
}

xn--b1aahg5aj0byd6a.xn--p1ai {
	root * /var/www/icanteven/current
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	@api path /events /stats
	handle @api {
		request_body {
			max_size 16
		}
		reverse_proxy 127.0.0.1:8787 {
			buffer_requests
			max_buffer_size 16
			header_up -Cookie
			header_up -User-Agent
			header_up -Referer
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_up -Forwarded
		}
	}
	handle {
		route {
			header Cache-Control "no-cache"
			header /assets/* Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
